# xAI API key — REQUIRED. The only provider used by openLesson.
# Used for:
#   - Grok text + vision chat (plan generation, probes, session plans, etc.)
#   - Files API (plan file uploads + PDF text extraction)
#   - Image generation (plan cover images via grok-imagine-image)
#   - Speech-to-Text (audio transcription + gap analysis)
# Get your key at https://console.x.ai
XAI_API_KEY=xai-...

# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (for pricing & subscriptions)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (create in Stripe Dashboard)
# Product "openLesson Regular" — $4.99/month recurring
STRIPE_PRICE_REGULAR=price_...
# Product "openLesson Pro" — $14.99/month recurring
STRIPE_PRICE_PRO=price_...
# Product "Extra Lesson" — $1.99 one-time
STRIPE_PRICE_EXTRA=price_...

# Solana Proof Anchoring (optional — falls back to simulated if not set)
# All 5 vars must be set to enable real on-chain anchoring
SOLANA_NETWORK=localnet
SOLANA_RPC_URL=http://localhost:8899
SOLANA_PROGRAM_ID=6kFPmDutPLRigDcyKaLAtRnDbBZAh7teLfAMQLWhZJ5J
SOLANA_FEE_PAYER_SECRET_KEY=
SOLANA_WALLET_ENCRYPTION_KEY=
