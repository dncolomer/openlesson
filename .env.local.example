# xAI API key — cloud default. Used for Grok chat, Files, and STT.
# Get your key at https://console.x.ai
XAI_API_KEY=xai-...

# OpenRouter — AI-use region simulation only (never getChat()).
# The API key is stored on the organization (Dashboard → Organization), not here.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_JOB_MAX_USD=5
# REGION_SIM_JOBS=1
# REGION_SIM_CANVAS_FAITHFUL=1
# REGION_SIM_AI_USE=1
# CRON_SECRET=

# Optional OpenAI-compatible chat (local / on-prem). Unset = xAI.
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3
# AI_CANVAS_ASK_MODEL=
# AI_CANVAS_COMMAND_MODEL=

# Blob store. Default xai (Files API). Local/on-prem:
# BLOB_STORE=fs
# BLOB_STORE_DIR=/var/openlesson/blobs
# Leave XAI_MANAGEMENT_API_KEY / XAI_TEAM_ID unset to skip org collection provision.

# Dantes.io Partner API key — optional, enables the Dantes session tool.
DANTES_API_KEY=...

# Supabase configuration (production / main branch)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Pooler URL from Dashboard → Settings → Database → Connection string (Session mode)
SUPABASE_DB_URL=postgresql://postgres.your-ref:YOUR_PASSWORD@aws-1-eu-west-2.pooler.supabase.com:5432/postgres

# Staging persistent branch (password is often DIFFERENT from production — copy from branch dashboard)
STAGING_NEXT_PUBLIC_SUPABASE_URL=https://your-staging-ref.supabase.co
# Session pooler (port 5432). Scripts auto-convert db.*.supabase.co URLs to pooler format.
STAGING_SUPABASE_DB_URL=postgresql://postgres:STAGING_BRANCH_PASSWORD@db.your-staging-ref.supabase.co:5432/postgres

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Path embeddings host (same production service locally and on Vercel).
# Persist POSTs /v1/embed with Authorization: Bearer $FLOWCFG_EMBEDDINGS_API_KEY.
FLOWCFG_EMBEDDINGS_BASE_URL=https://flowcfg-embeddings.vercel.app
FLOWCFG_EMBEDDINGS_API_KEY=sk-flowcfg-...

# WorkOS User Management (enterprise SSO). Optional; password and magic-link stay.
# WORKOS_API_KEY=sk_test_...
# WORKOS_CLIENT_ID=client_...
# WORKOS_REDIRECT_URI=http://localhost:3000/auth/workos/callback

# MCP OAuth signing secret (optional; defaults to SUPABASE_SERVICE_ROLE_KEY in dev)
MCP_OAUTH_SECRET=

# Stripe (for pricing & subscriptions)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (create in Stripe Dashboard)
# Product "Uncertain Systems Regular" — $4.99/month recurring
STRIPE_PRICE_REGULAR=price_...
# Product "Uncertain Systems Pro" — $14.99/month recurring
STRIPE_PRICE_PRO=price_...
# Product "Extra Lesson" — $1.99 one-time
STRIPE_PRICE_EXTRA=price_...

# Solana Proof Anchoring (optional — falls back to simulated if not set)
# All 5 vars must be set to enable real on-chain anchoring
SOLANA_NETWORK=localnet
SOLANA_RPC_URL=http://localhost:8899
SOLANA_PROGRAM_ID=6kFPmDutPLRigDcyKaLAtRnDbBZAh7teLfAMQLWhZJ5J
SOLANA_FEE_PAYER_SECRET_KEY=
SOLANA_WALLET_ENCRYPTION_KEY=
