# Copy to .env.e2e and fill in. Never commit .env.e2e.
# Required guard — scripts refuse to write to prod without this.
ALLOW_PROD_E2E=1

# Dedicated test accounts (use +aliases, e.g. you+e2e-regular@domain.com)
E2E_REGULAR_EMAIL=
E2E_REGULAR_PASSWORD=
E2E_TEAMS_EMAIL=
E2E_TEAMS_PASSWORD=

# Filled automatically by scripts/setup-e2e-test-users.mjs
E2E_REGULAR_USER_ID=
E2E_TEAMS_USER_ID=
E2E_TEAMS_ORG_ID=
E2E_TEAMS_API_KEY=

# Local app URL for HTTP checks
E2E_BASE_URL=http://127.0.0.1:3000

# Set to 1 to run xAI-backed writes (workspace create, GHL link). Costs tokens.
E2E_ALLOW_LIVE_WRITES=0