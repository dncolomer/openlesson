{
  "name": "uncertain-systems",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-expanded-e2e.mjs",
    "test:e2e:pow-api": "node scripts/run-pow-api-e2e.mjs",
    "check:locales": "node scripts/check-locale-parity.mjs",
    "check:openrouter-catalog": "vite-node --config vitest.config.ts scripts/check-openrouter-catalog.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:locales",
    "generate:prompt-inventory": "node scripts/discover-llm-prompts.mjs && node scripts/generate-prompt-inventory.mjs",
    "generate:prompt-report": "node scripts/discover-llm-prompts.mjs && node scripts/generate-prompt-report.mjs",
    "db:build-baseline": "node scripts/build-baseline-migration.mjs",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:migrate:staging": "node scripts/apply-migrations.mjs --staging",
    "db:check-drift": "node scripts/check-migration-drift.mjs",
    "db:check-drift:staging": "node scripts/check-migration-drift.mjs --staging",
    "db:verify-rls": "node scripts/verify-rls-policies.mjs",
    "db:types": "supabase gen types typescript --linked > lib/supabase/database.types.ts",
    "db:seed-localhost-verification-studio": "vite-node --config vitest.config.ts scripts/seed-localhost-verification-studio.ts",
    "db:seed-production-studio-demos": "vite-node --config vitest.config.ts scripts/seed-production-studio-demo-sets.ts",
    "corpus:backup": "vite-node --config vitest.config.ts scripts/backup-session-corpus.ts",
    "corpus:reembed": "vite-node --config vitest.config.ts scripts/reembed-session-corpus.ts",
    "corpus:harness": "vite-node --config vitest.config.ts scripts/flow-embedding-harness.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0-c0a0ca3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.18",
    "katex": "^0.16.33",
    "lucide-react": "^0.562.0",
    "next": "16.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "stripe": "20.4.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-bluetooth": "^0.0.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
